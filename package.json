{
    "name":  "@xmmtr/dsh-file-menu",
    "version":  "0.1.9",
    "description":  "Better Right-Click — right-click menu on file references in the DSH transcript: copy the absolute path, reveal the file in Explorer, or open it with any app registered for that file type. Bilingual (follows the DSH locale).",
    "license":  "MIT",
    "publishConfig":  {
                          "access":  "public"
                      },
    "author":  "xmmtr",
    "type":  "module",
    "main":  "lib/index.js",
    "exports":  {
                    ".":  "./lib/index.js",
                    "./client":  "./lib/client.js",
                    "./labels":  "./lib/labels.js",
                    "./package.json":  "./package.json"
                },
    "files":  [
                  "scripts",
                  "lib",
                  "cordis.patch.yml",
                  "README.md",
                  "TODO.md",
                  "LICENSE"
              ],
    "keywords":  [
                     "dsh-plugin",
                     "dsh",
                     "deepseek-harness",
                     "file-menu",
                     "context-menu",
                     "open-with",
                     "explorer",
                     "better-right-click"
                 ],
    "engines":  {
                    "node":  "\u003e=20.18.1",
                    "dsh":  "\u003e=0.2.1-rc.2 \u003c0.3.0"
                },
    "dsh":  {
                "manifestVersion":  1,
                "bundle":  {
                               "patch":  "./cordis.patch.yml"
                           },
                "client":  {
                               "platform":  "web",
                               "inject":  [

                                          ]
                           }
            },
    "repository":  {
                       "type":  "git",
                       "url":  "git+https://github.com/xmmtr/dsh-file-menu.git"
                   },
    "homepage":  "https://github.com/xmmtr/dsh-file-menu#readme",
    "bugs":  {
                 "url":  "https://github.com/xmmtr/dsh-file-menu/issues"
             }
}